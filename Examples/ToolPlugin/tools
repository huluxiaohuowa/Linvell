#!/usr/bin/env python3
"""Self-contained program entry points; system toolchains remain explicit prerequisites."""
import os,sys,shutil,subprocess
mode=sys.argv[1]
if mode=='language':
    tool=shutil.which('clangd')
    if not tool and sys.platform=='darwin':tool=subprocess.check_output(['xcrun','--find','clangd'],text=True).strip()
    if not tool:raise SystemExit('Install clangd on the project host first.')
    os.execv(tool,[tool,'--background-index=false','--log=error'])
elif mode=='debug':
    tool=shutil.which('lldb-dap')
    if not tool and sys.platform=='darwin':tool=subprocess.check_output(['xcrun','--find','lldb-dap'],text=True).strip()
    if not tool:raise SystemExit('Install lldb-dap on the project host first.')
    os.execv(tool,[tool])
elif mode=='task':
    print('Plugin task running on '+sys.platform+' in '+os.getcwd(),flush=True)
    subprocess.run(['cc','-g','main.c','-o','main'],check=True)
    subprocess.run(['./main'],check=True)
